{
    "name": "xlabrouter",
    "version": "1.0.48",
    "description": "Global CLI and web dashboard for RouterLab",
    "private": false,
    "preferGlobal": true,
    "license": "ISC",
    "bin": {
        "xlabrouter": "bin/xlab_router.js",
        "omniroute": "bin/xlab_router.js",
        "9router": "bin/xlab_router.js",
        "cliproxyapi": "bin/xlab_router.js",
        "xlabuter": "bin/xlab_router.js",
        "xrouter": "bin/xlab_router.js"
    },
    "scripts": {
        "dev": "next dev --webpack --port 1212",
        "dev:turbo": "next dev --turbo --port 1212",
        "build": "next build --webpack",
        "lint": "eslint src/app/api src/lib src/sse src/shared/utils bin tests --ext .js",
        "lint:fix": "eslint . --fix",
        "typecheck": "node -e \"console.log('No TypeScript project configured; skipping typecheck.')\"",
        "format:check": "node -e \"console.log('No Prettier configured; skipping format check.')\"",
        "test": "vitest run --config tests/vitest.config.js",
        "test:coverage": "vitest run --coverage --config tests/vitest.config.js",
        "test:vps-smoke": "node tester/api-test.mjs",
        "test:models": "vitest run --config tests/vitest.config.js tests/unit/models.test.js",
        "quality:gate": "npm run lint && npm run test && npm run build",
        "quality:gate:coverage": "npm run quality:gate && npm run test:coverage",
        "start": "node ./bin/xlab_router.js --web",
        "ddns:cloudflare": "node scripts/cloudflare-ddns.js",
        "usage:compact": "node scripts/compact-usage-store.mjs",
        "usage:compact:apply": "node scripts/compact-usage-store.mjs --apply",
        "usage:sync:9router": "node scripts/sync-9router-usage.mjs",
        "usage:sync:9router:install": "bash scripts/install-9router-usage-sync.sh",
        "dev:bun": "bun --bun next dev --webpack --port 1212",
        "dev:bun:turbo": "bun --bun next dev --turbo --port 1212",
        "build:bun": "bun --bun next build --webpack",
        "start:bun": "bun ./.next/standalone/server.js",
        "postinstall": "node scripts/check-tailscale.js",
        "uninstall": "node scripts/uninstall.mjs",
        "uninstall:full": "node scripts/uninstall.mjs --full"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/postcss": "^4.2.2",
        "@xyflow/react": "^12.10.2",
        "confbox": "^0.2.4",
        "express": "^5.2.1",
        "fs": "^0.0.1-security",
        "http-proxy-middleware": "^3.0.5",
        "inquirer": "^9.3.8",
        "jose": "^6.2.2",
        "lowdb": "^7.0.1",
        "monaco-editor": "^0.55.1",
        "next": "^16.2.6",
        "node-forge": "^1.4.0",
        "node-machine-id": "^1.1.12",
        "open": "^11.0.0",
        "ora": "^9.3.0",
        "prop-types": "^15.8.1",
        "proper-lockfile": "^4.1.2",
        "qrcode": "^1.5.4",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-is": "^16.13.1",
        "recharts": "^3.8.1",
        "selfsigned": "^5.5.0",
        "socks-proxy-agent": "^8.0.5",
        "sql.js": "^1.14.1",
        "systray2": "^2.1.4",
        "undici": "^7.25.0",
        "uuid": "^13.0.1",
        "zustand": "^5.0.12"
    },
    "optionalDependencies": {
        "better-sqlite3": "^12.9.0"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "eslint-config-next": "16.1.6",
        "postcss": "^8.5.10",
        "tailwindcss": "^4",
        "vitest": "^4.1.7",
        "@vitest/coverage-v8": "^4.1.7"
    },
    "main": "index.js",
    "directories": {
        "doc": "docs",
        "test": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quangminh1212/XLab_Router.git"
    },
    "keywords": [],
    "author": "",
    "bugs": {
        "url": "https://github.com/quangminh1212/XLab_Router/issues"
    },
    "homepage": "https://github.com/quangminh1212/XLab_Router#readme",
    "overrides": {
        "dompurify": "^3.4.2",
        "postcss": "^8.5.10"
    }
}
