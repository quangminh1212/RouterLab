# xlabrouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/xlabrouter

# Recommended runtime variables
PORT=1212
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:1212
CLOUD_URL=https://xlabrouter.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:1212
NEXT_PUBLIC_CLOUD_URL=https://xlabrouter.com

# Optional: Cloudflare Named Tunnel (stable URL across restarts)
# 1) Create a tunnel in Cloudflare Zero Trust and copy its token
# 2) Configure a stable public hostname in the tunnel settings
# 3) Set both values below
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...<redacted>...
# CLOUDFLARE_TUNNEL_PUBLIC_URL=https://myrouter.example.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional: auto-sync local Claude/Codex CLI settings when running run.bat
# Auto-sync is enabled when at least one of these model vars is set.
# XLABROUTER_CLI_BASE_URL=http://localhost:1212/v1
# XLABROUTER_CLI_API_KEY=sk_xlabrouter
# XLABROUTER_CLAUDE_OPUS_MODEL=provider/model-id
# XLABROUTER_CLAUDE_SONNET_MODEL=provider/model-id
# 9router usage DB sync (hourly cron on target VPS)
# SOURCE_USAGE_FILE=/root/.9router/usage.json
# SOURCE_ID=9router-vps-36.50.26.247
# TARGET_BASE_URL=http://127.0.0.1:1212
# TARGET_USERNAME=admin
# TARGET_PASSWORD=123456
# STATE_FILE=/var/lib/xlabrouter/9router-usage-sync-state.json
# Installer: TARGET_PASSWORD='...' APP_DIR=/opt/XLab_Router bash scripts/install-9router-usage-sync.sh
# XLABROUTER_CLAUDE_HAIKU_MODEL=provider/model-id
# XLABROUTER_CODEX_MODEL=provider/model-id
# XLABROUTER_CODEX_SUBAGENT_MODEL=provider/model-id
# XLABROUTER_SHORTCUT_DIR=C:\Dev\Work\2000\shortcut

# Route timeouts (ms). Chat default was 60s and breaks Hermes agent/skill turns.
# Hermes request_timeout_seconds=300 — keep these aligned for agent workloads.
# CHAT_COMPLETIONS_TIMEOUT_MS=300000
# DEFAULT_FETCH_TIMEOUT_MS=180000
# STREAMING_FETCH_TIMEOUT_MS=300000
# RUNTIME_TIMEOUT_TRIP_THRESHOLD=5
# RUNTIME_CIRCUIT_OPEN_MS=5000
# OPENCLAW_CAPTURE_PROXY_TIMEOUT_MS=30000

# Optional: OpenClaw compatibility/capture routing
# Keep empty unless a dedicated compatibility tunnel is required.
# OPENCLAW_COMPAT_TOKEN=sk_openclaw_compat
# OPENCLAW_TUNNEL_ALLOW_TOKENS=sk_openclaw_compat
# OPENCLAW_CAPTURE_PROXY=false
# OPENCLAW_CAPTURE_PROXY_TOKENS=sk_openclaw_compat
# OPENCLAW_CAPTURE_PROXY_UPSTREAM_URL=https://api.xlabrnd.com/v1/chat/completions

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=xlabrouter

# Google Drive Desktop OAuth (local flow)
# 1) Create OAuth Client ID type "Desktop app" in Google Cloud Console
# 2) Paste client id here (secret optional)
GOOGLE_DESKTOP_CLIENT_ID=
# GOOGLE_DESKTOP_CLIENT_SECRET=
# Backward-compatible vars still supported:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Keep session for 90 days (default)
# GOOGLE_SESSION_MAX_AGE_SECONDS=7776000
